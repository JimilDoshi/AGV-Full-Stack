<?xml version="1.0"?>
<!--
  AGV Rover URDF — skid-steer, 4-wheel hub motor platform
  Uses xacro so dimensions are defined once at the top.

  ==========================================================================
  FILL IN YOUR 3 MEASUREMENTS BELOW (all in metres):
  ==========================================================================
  ROVER_WIDTH  — outside edge of left wheel to outside edge of right wheel
  ROVER_LENGTH — front to back of chassis
  ROVER_HEIGHT — ground to top of chassis (not including LiDAR)

  These must match the values you put in sensors.launch.py:
    LIDAR_Z  should be ROVER_HEIGHT + height of LiDAR mount above chassis
    CAMERA_Z should be ROVER_HEIGHT + height of camera above chassis
  ==========================================================================
-->
<robot name="agv" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ======================================================================
       FILL IN DIMENSIONS
       ====================================================================== -->
  <xacro:property name="ROVER_WIDTH"  value="0.66"/>   <!-- wheel centre to wheel centre -->
  <xacro:property name="ROVER_LENGTH" value="0.90"/>   <!-- front to back -->
  <xacro:property name="ROVER_HEIGHT" value="0.30"/>   <!-- ground to chassis top -->

  <!-- Derived values — do not edit -->
  <xacro:property name="BASE_X"  value="${ROVER_LENGTH / 2.0}"/>
  <xacro:property name="BASE_Y"  value="${ROVER_WIDTH  / 2.0}"/>
  <xacro:property name="BASE_Z"  value="${ROVER_HEIGHT / 2.0}"/>

  <!-- LiDAR offset — must match sensors.launch.py LIDAR_X and LIDAR_Z -->
  <xacro:property name="LIDAR_X" value="0.38"/>   <!-- 38 cm ahead of rover centre -->
  <xacro:property name="LIDAR_Z" value="0.46"/>   <!-- 46 cm above ground -->

  <!-- Camera offset — must match sensors.launch.py CAMERA_Z -->
  <xacro:property name="CAMERA_Z" value="0.155"/> <!-- 15.5 cm above ground -->

  <!-- ======================================================================
       LINKS
       ====================================================================== -->

  <!-- base_link: geometric centre of rover at ground level -->
  <link name="base_link">
    <visual>
      <geometry>
        <box size="${ROVER_LENGTH} ${ROVER_WIDTH} ${ROVER_HEIGHT}"/>
      </geometry>
      <origin xyz="0 0 ${BASE_Z}" rpy="0 0 0"/>
      <material name="grey">
        <color rgba="0.5 0.5 0.5 1.0"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <box size="${ROVER_LENGTH} ${ROVER_WIDTH} ${ROVER_HEIGHT}"/>
      </geometry>
      <origin xyz="0 0 ${BASE_Z}" rpy="0 0 0"/>
    </collision>
    <inertial>
      <!-- Approximate — tune if using a physics simulator -->
      <mass value="10.0"/>
      <origin xyz="0 0 ${BASE_Z}" rpy="0 0 0"/>
      <inertia ixx="0.1" ixy="0.0" ixz="0.0"
               iyy="0.1" iyz="0.0"
               izz="0.1"/>
    </inertial>
  </link>

  <!-- laser: RPLiDAR A1 -->
  <link name="laser">
    <visual>
      <geometry>
        <cylinder radius="0.038" length="0.041"/>
      </geometry>
      <material name="black">
        <color rgba="0.1 0.1 0.1 1.0"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <cylinder radius="0.038" length="0.041"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.17"/>
      <inertia ixx="0.0001" ixy="0.0" ixz="0.0"
               iyy="0.0001" iyz="0.0"
               izz="0.0001"/>
    </inertial>
  </link>

  <!-- camera_link: Logitech webcam -->
  <link name="camera_link">
    <visual>
      <geometry>
        <box size="0.09 0.025 0.025"/>
      </geometry>
      <material name="blue">
        <color rgba="0.0 0.0 0.8 1.0"/>
      </material>
    </visual>
    <inertial>
      <mass value="0.1"/>
      <inertia ixx="0.00001" ixy="0.0" ixz="0.0"
               iyy="0.00001" iyz="0.0"
               izz="0.00001"/>
    </inertial>
  </link>

  <!-- ======================================================================
       JOINTS
       ====================================================================== -->

  <!-- base_link → laser (must match static TF in sensors.launch.py) -->
  <joint name="laser_joint" type="fixed">
    <parent link="base_link"/>
    <child  link="laser"/>
    <origin xyz="${LIDAR_X} 0.0 ${LIDAR_Z}" rpy="0 0 0"/>
  </joint>

  <!-- base_link → camera_link -->
  <joint name="camera_joint" type="fixed">
    <parent link="base_link"/>
    <child  link="camera_link"/>
    <origin xyz="${LIDAR_X} 0.0 ${CAMERA_Z}" rpy="0 0 0"/>
  </joint>

</robot>
